@@ -19,8 +19,14 @@ class CmdVelSubscriberNode : public rclcpp::Node {
       : Node("g1_cmd_vel_subscriber_node"),
         client_(this), 
         last_cmd_vel_received_time_(this->now()),
-        watchdog_timeout_(100ms) // 0.1秒間 cmd_vel が来なければ停止
+        watchdog_timeout_(rclcpp::Duration::from_seconds(0.35))
   {
+    // 100 ms was only two velocity-smoother periods and caused real StopMove()
+    // calls during ordinary scheduler/DDS jitter. Keep the safety watchdog, but
+    // allow several missed 20 Hz samples before stopping.
+    const double cmd_vel_timeout = this->declare_parameter<double>("cmd_vel_timeout", 0.35);
+    watchdog_timeout_ = rclcpp::Duration::from_seconds(
+      std::max(0.10, cmd_vel_timeout));
     // --- 重要: コールバックグループの設定 ---
     
     // 1. cmd_vel 受信用 (並列実行許可: Reentrant)
@@ -69,7 +75,9 @@ class CmdVelSubscriberNode : public rclcpp::Node {
